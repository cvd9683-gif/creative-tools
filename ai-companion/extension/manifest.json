{
  "manifest_version": 3,
  "name": "Derby",
  "version": "0.1.0",
  "description": "A carnival-derby tracker for your open AI chats on Claude, ChatGPT and Grok. One glance tells you which chat needs you.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://grok.com/*",
    "http://127.0.0.1:47800/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "widget/panel.html"
  },
  "action": {
    "default_title": "Derby",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/sites/claude.js",
        "content/core.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/sites/chatgpt.js",
        "content/core.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "content/sites/grok.js",
        "content/core.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "pages/settings.html"
}
